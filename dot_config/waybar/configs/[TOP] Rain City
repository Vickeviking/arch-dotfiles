// ### Rain City - three floating islands, colors from desk-theme (~/.config/themes/current/colors.css) ###
// Pair with style "[Desk] Themed.css". Previous layout: "[TOP] Default Laptop".
{
"include": [
  "$HOME/.config/waybar/Modules",
  "$HOME/.config/waybar/ModulesWorkspaces",
  "$HOME/.config/waybar/ModulesCustom",
  "$HOME/.config/waybar/ModulesGroups",
  "$HOME/.config/waybar/UserModules",
  ],
"layer": "top",
"exclusive": true,
"passthrough": false,
"position": "top",
"height": 34,
"spacing": 4,
"fixed-center": true,
"ipc": true,
"margin-top": 8,
"margin-left": 10,
"margin-right": 10,
"margin-bottom": 0,

// study timer (~/.local/bin/desk-pomodoro): click start/pause, middle skip,
// right reset, scroll changes the focus length
"custom/pomodoro": {
	"exec": "$HOME/.local/bin/desk-pomodoro",
	"return-type": "json",
	"interval": 1,
	"signal": 13,
	"format": "{}",
	"on-click": "$HOME/.local/bin/desk-pomodoro toggle",
	"on-click-middle": "$HOME/.local/bin/desk-pomodoro skip",
	"on-click-right": "$HOME/.local/bin/desk-pomodoro reset",
	"on-scroll-up": "$HOME/.local/bin/desk-pomodoro longer",
	"on-scroll-down": "$HOME/.local/bin/desk-pomodoro shorter",
	"tooltip": true,
},

"modules-left": [
	"group/app_drawer",
	"hyprland/workspaces#rw",
	"hyprland/window",
	],

"modules-center": [
	"custom/player_prev",
	"custom/player_toggle",
	"custom/player_next",
	"custom/playerctl",
	"clock",
	"custom/pomodoro",
	"custom/arcturon_server",
	"custom/shutdown_timer",
	],

"modules-right": [
	"privacy",
	"custom/desk_camera",
	"custom/desk_updates",
	"tray",
	"network#speed",
	"group/audio",
	"group/mobo_drawer",
	"group/desk_laptop",
	"idle_inhibitor",
	"group/notify",
	"custom/power",
	],
}
