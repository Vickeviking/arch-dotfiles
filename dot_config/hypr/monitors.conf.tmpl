# ===================================================== #
# === Viktor's Active Dual Monitor Setup (Arch 2025) === #
# ===================================================== #

# Extern skärm matchas på beskrivning i stället för portnamn, så profilen
# fortsätter fungera även om dockan exponerar den som t.ex. DP-4 i stället
# för DP-1/DP-2/HDMI-A-1.
monitor=desc:Samsung Electric Company S27B80T HCJX400562,3840x2160@60,-2560x0,1.5

# Performance note:
# The laptop panel starts at 60Hz here because that is the safest docked default.
# RefreshModeDaemon.py will automatically raise it back to 240Hz when no external
# monitor is connected, and drop it to 60Hz again when docked.
# To restore 240Hz later, either:
# 1. change the eDP-2 and eDP-1 lines below from @60 to @240, or
# 2. load ~/.config/hypr/Monitor_Profiles/default.conf via MonitorProfiles.sh,
# 3. or disable the refresh-mode daemon in Startup_Apps.conf.
# This file is sourced on Hyprland startup, but can be overwritten by nwg-displays
# or by loading a different profile script.
# Laptopskärmen (eDP-2) 2560x1600@60, placerad till höger (RIGHT side)
monitor=eDP-2,2560x1600@60,0x0,1.6

# Fallback for eDP-1 (in case it switches)
monitor=eDP-1,2560x1600@60,0x0,1.6
