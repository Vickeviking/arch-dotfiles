{{ if eq .chezmoi.hostname "vango-arch-thinkpad" -}}
#!/bin/bash
# /* ---- 💫 https://github.com/JaKooLit 💫 ---- */  ##
# Script for Monitor backlights (if supported) using brightnessctl

iDIR="$HOME/.config/swaync/icons"
notification_timeout=1000
step=10  # INCREASE/DECREASE BY THIS VALUE

# Backlight device.
#
# This used to be hardcoded to "intel_backlight", which does not exist on this
# machine (AMD Ryzen -> the panel shows up as "amdgpu_bl1"). Every call failed
# with "Device 'intel_backlight' not found", so the Fn brightness keys and the
# Waybar scroll action silently did nothing.
#
# Detect it instead. Preference order follows the kernel's own convention:
# firmware > platform > raw, since firmware/platform devices track the real
# panel more reliably when several are exposed.
detect_backlight() {
    local dev best_type="" best_dev=""
    for dev in /sys/class/backlight/*; do
        [ -e "$dev/brightness" ] || continue
        local name type
        name=$(basename "$dev")
        type=$(cat "$dev/type" 2>/dev/null)
        case "$type" in
            firmware) echo "$name"; return 0 ;;
            platform) [ "$best_type" = "platform" ] || { best_type=platform; best_dev=$name; } ;;
            *)        [ -n "$best_dev" ] || { best_type=raw; best_dev=$name; } ;;
        esac
    done
    [ -n "$best_dev" ] && { echo "$best_dev"; return 0; }
    return 1
}

BACKLIGHT_DEVICE="${BACKLIGHT_DEVICE:-$(detect_backlight)}"

if [ -z "$BACKLIGHT_DEVICE" ]; then
    echo "No backlight device found under /sys/class/backlight" >&2
    exit 1
fi

# Get current brightness as an integer (without %)
get_brightness() {
    brightnessctl -d "$BACKLIGHT_DEVICE" -m | cut -d, -f4 | tr -d '%'
}

# Determine the icon based on brightness level
get_icon_path() {
    local brightness=$1
    local level=$(( (brightness + 19) / 20 * 20 ))  # Round up to next 20
    if (( level > 100 )); then
        level=100
    fi
    local icon="$iDIR/brightness-${level}.png"
    # Fall back to a themed icon name when the JaKooLit icon set is absent.
    [ -f "$icon" ] || icon="display-brightness-symbolic"
    echo "$icon"
}

# Send notification
send_notification() {
    local brightness=$1
    local icon_path=$2

    command -v notify-send >/dev/null || return 0

    notify-send -e \
        -h string:x-canonical-private-synchronous:brightness_notif \
        -h int:value:"$brightness" \
        -u low \
        -i "$icon_path" \
        "Screen" "Brightness: ${brightness}%"
}

# Change brightness and notify
change_brightness() {
    local delta=$1
    local current new icon

    current=$(get_brightness)
    new=$((current + delta))

    # Clamp between 5 and 100
    (( new < 5 )) && new=5
    (( new > 100 )) && new=100

    brightnessctl -d "$BACKLIGHT_DEVICE" set "${new}%" >/dev/null

    icon=$(get_icon_path "$new")
    send_notification "$new" "$icon"
}

# Set an absolute level and notify
set_brightness() {
    local new=$1 icon
    (( new < 5 )) && new=5
    (( new > 100 )) && new=100
    brightnessctl -d "$BACKLIGHT_DEVICE" set "${new}%" >/dev/null
    icon=$(get_icon_path "$new")
    send_notification "$new" "$icon"
}

# Step through a few presets. Used by the Waybar click action, since the
# backlight module only reacts to scroll on its own.
cycle_brightness() {
    local current=$(get_brightness)
    if   (( current <= 25 )); then set_brightness 50
    elif (( current <= 50 )); then set_brightness 75
    elif (( current <= 75 )); then set_brightness 100
    else                           set_brightness 25
    fi
}

# Main
case "$1" in
    "--get")
        get_brightness
        ;;
    "--inc")
        change_brightness "$step"
        ;;
    "--dec")
        change_brightness "-$step"
        ;;
    "--set")
        set_brightness "${2:-100}"
        ;;
    "--cycle")
        cycle_brightness
        ;;
    "--device")
        echo "$BACKLIGHT_DEVICE"
        ;;
    *)
        get_brightness
        ;;
esac
{{ else -}}
