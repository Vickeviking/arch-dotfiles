# >>> git-anim: slam dunk on push, crate haul on pull (GIT_ANIM_OFF=1 to disable) >>>
git() {
  if [[ -t 1 && -z $GIT_ANIM_OFF && ( $1 == push || $1 == pull ) ]]; then
    local _ga_before=$(command git rev-parse HEAD 2>/dev/null)
    command git "$@"
    local _ga_rc=$?
    python3 ~/.local/bin/git-anim "$1" "$_ga_rc" "$_ga_before"
    return $_ga_rc
  fi
  command git "$@"
}
# <<< git-anim <<<
