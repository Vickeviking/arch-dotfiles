{{ if eq .chezmoi.hostname "vango-arch-thinkpad" -}}
# If you come from bash you might have to change your $PATH.
# export PATH=$HOME/bin:/usr/local/bin:$PATH

export ZSH="$HOME/.oh-my-zsh"

ZSH_THEME="agnosterzak"
# starship takes over the prompt once installed (colors from desk-theme, ~/.config/starship.toml)
command -v starship >/dev/null && ZSH_THEME=""

plugins=(
    git
    archlinux
    zsh-autosuggestions
    zsh-syntax-highlighting
)

source $ZSH/oh-my-zsh.sh
command -v starship >/dev/null && eval "$(starship init zsh)"

# Check archlinux plugin commands here
# https://github.com/ohmyzsh/ohmyzsh/tree/master/plugins/archlinux

# Display Pokemon-colorscripts
# Project page: https://gitlab.com/phoneybadger/pokemon-colorscripts#on-other-distros-and-macos
#pokemon-colorscripts --no-title -s -r #without fastfetch
pokemon-colorscripts --no-title -s -r | fastfetch -c $HOME/.config/fastfetch/config-pokemon.jsonc --logo-type file-raw --logo-height 10 --logo-width 5 --logo -

# fastfetch. Will be disabled if above colorscript was chosen to install
#fastfetch -c $HOME/.config/fastfetch/config-compact.jsonc

# Set-up icons for files/directories in terminal using lsd
alias ls='lsd'
alias l='ls -l'
alias la='ls -a'
alias lla='ls -la'
alias lt='ls --tree'
alias sc='nvim ~/notes'
alias update='sudo pacman -Syu && yay -Syu --devel --timeupdate'
alias docker-clean="docker system prune -a --volumes"
# Set-up FZF key bindings (CTRL R for fuzzy history finder)
source <(fzf --zsh)

HISTFILE=~/.zsh_history
HISTSIZE=10000
SAVEHIST=10000
setopt appendhistory


# Alias

# config
alias cfgpush="$HOME/syncing/config_sync/push-configs.sh"
#alias cfgdeploy='$HOME/syncing/config_sync/deploy-configs.sh --confirm'
# computer backup
alias backpush="$HOME/syncing/computer_backup_sync/backup-push.sh"
#alias backdeploy='$HOME/syncing/computer_backup_sync/backup-deploy.sh --confirm'
export PATH="$HOME/.cargo/bin:$PATH"

# Fly.io CLI installed by flyctl installer.
export PATH="$HOME/.fly/bin:$PATH"

# .NET SDK installed without root privileges.
export DOTNET_ROOT="$HOME/.dotnet"
export PATH="$DOTNET_ROOT:$PATH"

alias code='code --ozone-platform-hint=auto --enable-features=UseOzonePlatform'

# fix cursor
if [[ -n “$APPIMAGE” && “$APPIMAGE” == cursor ]]; then
function cargo() {
env -i HOME=$HOME PATH=$HOME/.cargo/bin:/usr/bin:/bin “$HOME/.cargo/bin/cargo” “$@”
}
fi

