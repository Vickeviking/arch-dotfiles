#!/usr/bin/env bash
# desk-backup: nightly restic backup of this machine to the other one, over
# Tailscale (sftp). Run by the desk-backup.timer user unit once Viktor has set
# it up (see ~/.config/desk-backup/README.md).
#
#   desk-backup            back up now (and forget old snapshots)
#   desk-backup snapshots  list what's there
#   desk-backup restore <snapshot> <path> <into-dir>   restore a path
#   desk-backup check      verify the repository
#
# What: ~/dev, the chezmoi source, ~/Documents, ~/Pictures (minus build output
# and caches, see excludes), plus a pg_dump of Arcturon's dev database when its
# container runs. Keeps 7 daily, 4 weekly, 6 monthly snapshots.
set -euo pipefail

conf="$HOME/.config/desk-backup"
pass="$conf/password"
case "$(hostname)" in
legion-arch) target=vango-arch-thinkpad ;;
*) target=legion-arch ;;
esac
export RESTIC_REPOSITORY="${RESTIC_REPOSITORY:-sftp:vango@$target:/home/vango/backups/$(hostname)}"
export RESTIC_PASSWORD_FILE="$pass"

if ! command -v restic >/dev/null; then
	echo "desk-backup: restic isn't installed (sudo pacman -S restic)" >&2
	exit 1
fi
if [ ! -r "$pass" ]; then
	echo "desk-backup: no password file at $pass (see $conf/README.md)" >&2
	exit 1
fi

case "${1:-backup}" in
snapshots) exec restic snapshots ;;
check) exec restic check ;;
restore)
	[ $# -eq 4 ] || { echo "usage: desk-backup restore <snapshot> <path> <into-dir>" >&2; exit 2; }
	exec restic restore "$2" --include "$3" --target "$4"
	;;
backup) ;;
*) echo "desk-backup: unknown command $1" >&2; exit 2 ;;
esac

if ! ssh -o ConnectTimeout=8 -o BatchMode=yes "vango@$target" true 2>/dev/null; then
	echo "desk-backup: $target doesn't answer; skipping tonight" >&2
	exit 0
fi

# Arcturon's dev database, read-only dump (only if the container runs)
dumps="$HOME/.local/state/desk-backup"
mkdir -p "$dumps"
if docker ps --format '{{.Names}}' 2>/dev/null | grep -qx arcturon-dev-pg; then
	docker exec arcturon-dev-pg pg_dump -U postgres arturonDb >"$dumps/arcturon-dev.sql.tmp" &&
		mv "$dumps/arcturon-dev.sql.tmp" "$dumps/arcturon-dev.sql"
fi

paths=("$HOME/dev" "$HOME/.local/share/chezmoi" "$HOME/Documents" "$HOME/Pictures" "$dumps")
existing=()
for p in "${paths[@]}"; do [ -e "$p" ] && existing+=("$p"); done

restic backup --exclude-file "$conf/excludes" --exclude-caches --one-file-system \
	--tag nightly "${existing[@]}"
restic forget --keep-daily 7 --keep-weekly 4 --keep-monthly 6 --prune
