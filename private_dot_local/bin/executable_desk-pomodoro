#!/usr/bin/env python3
"""desk-pomodoro: a study timer in waybar (custom/pomodoro, signal 13).

  desk-pomodoro            status as JSON for waybar (also notices when a phase ends)
  desk-pomodoro toggle     start, pause or resume            (left click)
  desk-pomodoro reset      stop and clear today's rounds      (right click)
  desk-pomodoro skip       end the current phase now          (middle click)
  desk-pomodoro longer     +5 min focus when idle             (scroll up)
  desk-pomodoro shorter    −5 min focus when idle             (scroll down)

Focus 25 min, then a 5 min break (15 min after every 4th round); the break
starts by itself, the next focus waits for your click. Each end plays a pling
(desk-sound, even in Do Not Disturb) and shows a notification. State lives in
~/.local/state/desk-pomodoro.json, so a running timer survives waybar restarts.
"""
import fcntl, json, os, subprocess, sys, time

HOME = os.path.expanduser("~")
STATE = os.path.join(HOME, ".local/state/desk-pomodoro.json")
LOCK = STATE + ".lock"
SHORT, LONG, EVERY = 5, 15, 4
SIGNAL = 13


def load():
    try:
        with open(STATE) as f:
            s = json.load(f)
    except (OSError, ValueError):
        s = {}
    s.setdefault("phase", "idle")       # idle | focus | break
    s.setdefault("paused", None)        # seconds left while paused, else None
    s.setdefault("end", 0)
    s.setdefault("focus_min", 25)
    today = time.strftime("%Y-%m-%d")
    if s.get("day") != today:           # rounds count per day
        s["day"], s["rounds"] = today, 0
    s.setdefault("rounds", 0)
    return s


def save(s):
    os.makedirs(os.path.dirname(STATE), exist_ok=True)
    tmp = STATE + ".tmp"
    with open(tmp, "w") as f:
        json.dump(s, f)
    os.replace(tmp, STATE)


def ping(sound, title, body):
    subprocess.Popen([os.path.join(HOME, ".local/bin/desk-sound"), sound],
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    subprocess.Popen(["notify-send", "-a", "Pomodoro", "-i", "alarm-symbolic", title, body],
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)


def refresh():
    subprocess.run(["pkill", f"-RTMIN+{SIGNAL}", "-x", "waybar"],
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def left(s):
    if s["paused"] is not None:
        return s["paused"]
    return max(0, int(round(s["end"] - time.time())))


def finish(s):
    """The running phase is over: focus → break (starts now), break → idle."""
    if s["phase"] == "focus":
        s["rounds"] += 1
        mins = LONG if s["rounds"] % EVERY == 0 else SHORT
        s.update(phase="break", paused=None, end=time.time() + mins * 60)
        ping("pomodoro-done", f"Focus done · round {s['rounds']}",
             f"Take a {mins} min break. Stand up, drink some water.")
    elif s["phase"] == "break":
        s.update(phase="idle", paused=None, end=0)
        ping("break-done", "Break over", "Click the timer when you're ready to focus again.")


def fmt(sec):
    return f"{sec // 60:02d}:{sec % 60:02d}"


def status(s):
    if s["phase"] != "idle" and s["paused"] is None and left(s) == 0:
        finish(s)
        save(s)
    dots = "".join("●" if i < s["rounds"] % EVERY or (s["rounds"] and s["rounds"] % EVERY == 0) else "○"
                   for i in range(EVERY))
    clicks = "left: start / pause · middle: skip · right: reset · scroll: focus length"
    if s["phase"] == "idle":
        text, cls = f"󱎫 {s['focus_min']}", "idle"
        tip = f"Pomodoro: {s['focus_min']} min focus · {s['rounds']} rounds today\n{clicks}"
    else:
        icon = "󰔟" if s["phase"] == "focus" else "󰾨"
        cls = s["phase"]
        if s["paused"] is not None:
            icon, cls = "󰏤", s["phase"] + " paused"
        text = f"{icon} {fmt(left(s))} {dots}"
        what = "Focus" if s["phase"] == "focus" else "Break"
        tip = f"{what}: {fmt(left(s))} left{' (paused)' if s['paused'] is not None else ''} · {s['rounds']} rounds today\n{clicks}"
    return {"text": text, "tooltip": tip, "class": cls.split(), "alt": s["phase"]}


def main(argv):
    cmd = argv[0] if argv else "status"
    os.makedirs(os.path.dirname(LOCK), exist_ok=True)
    with open(LOCK, "w") as lk:
        fcntl.flock(lk, fcntl.LOCK_EX)
        s = load()
        if cmd == "status":
            print(json.dumps(status(s), ensure_ascii=False), flush=True)
            return
        if cmd == "toggle":
            if s["phase"] == "idle":
                s.update(phase="focus", paused=None, end=time.time() + s["focus_min"] * 60)
            elif s["paused"] is None:
                s["paused"] = left(s)
            else:
                s.update(end=time.time() + s["paused"], paused=None)
        elif cmd == "reset":
            s.update(phase="idle", paused=None, end=0, rounds=0)
        elif cmd == "skip":
            if s["phase"] != "idle":
                finish(s)
        elif cmd in ("longer", "shorter") and s["phase"] == "idle":
            step = 5 if cmd == "longer" else -5
            s["focus_min"] = min(90, max(5, s["focus_min"] + step))
        elif cmd in ("-h", "--help"):
            print(__doc__.strip())
            return
        save(s)
    refresh()


if __name__ == "__main__":
    main(sys.argv[1:])
