#!/usr/bin/env bash
# desk-backup-password: create the restic password for desk-backup, once.
# Prints it so you can save it in your password manager; never overwrites one.
set -euo pipefail
f="$HOME/.config/desk-backup/password"
if [ -s "$f" ]; then
	echo "A backup password already exists ($f); not replacing it."
	exit 1
fi
install -m 600 /dev/null "$f"
head -c 30 /dev/urandom | base64 >"$f"
echo "Backup password (save it in your password manager):"
cat "$f"
